#!/bin/zsh
set -euo pipefail
SCRIPT_DIR="${0:A:h}"
if [[ "${1:-}" == "import" || "${1:-}" == "fetch" ]]; then
  command="$1"
  shift
  exec python3 "$SCRIPT_DIR/artifact.py" "$command" "$@" --state-file "$HOME/Library/Application Support/uaRO-CrossOver/state.json"
fi
exec python3 "$SCRIPT_DIR/artifact.py" "$@"
